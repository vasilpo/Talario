msgstr "Відображати кнопки соціальних мереж"

msgctxt "Languages::abt__ut2.settings.products.addon_social_buttons.view.tooltip"
msgid "Please note, that using this option slows down the loading of the product page. Not recommended for displaying on mobile devices."
msgstr "Зверніть увагу, увімкнення цієї опції сильно уповільнює завантаження сторінки товару. Не рекомендується до відображення на мобільних пристроях."

msgctxt "Languages::abt__ut2.addon_social_buttons.share"
msgid "Share"
msgstr "Поділитись"

msgctxt "Languages::abt__ut2.settings.load_more"
msgid "Show more"
msgstr "Показати ще"

msgctxt "Languages::abt__ut2.settings.load_more_description"
msgid "Below are the settings for the \"Show more\" functional for various objects in lists (lazy pagination)"
msgstr "Нижче наведені налаштування механізму \"Показати ще\" для різноманітних об'єктів у списках (лінива пагінація)"

msgctxt "Languages::abt__ut2.settings.load_more.product_list"
msgid "Allow for product lists"
msgstr "Дозволити для товарних списків"

msgctxt "Languages::abt__ut2.settings.load_more.product_list.tooltip"
msgid "Allow display of \"Show more\" button for categories, brands, newest pages etc."
msgstr "Дозволити відображення кнопки \"Показати ще\" для сторінок категорій, брендів, новинок тощо"

msgctxt "Languages::abt__ut2.settings.load_more.blog"
msgid "Allow for the Blog"
msgstr "Дозволити для Блога"

msgctxt "Languages::abt__ut2.settings.load_more.blog.tooltip"
