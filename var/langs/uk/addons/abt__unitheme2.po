msgstr "Нативний модуль CS-Cart \"Обов'язкові товари\" створює групи товарів, які будуть додані до кошику з товаром, на сторінці якого знаходиться користувач"

msgctxt "Languages::abt__ut2.settings.products.addon_required_products.list_type"
msgid "Template"
msgstr "Шаблон"

msgctxt "Languages::abt__ut2.settings.products.addon_required_products.list_type.tooltip"
