msgstr "Компактний список"

msgctxt "Languages::abt__ut2.settings.products.addon_required_products.list_type.variants.product_list"
msgid "List without options"
msgstr "Список без опцій"

msgctxt "Languages::abt__ut2.settings.products.addon_required_products.item_quantity"
