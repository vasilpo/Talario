msgstr "Дозволити відображення кнопки \"Показати ще\" для постів блогу"

msgctxt "Languages::abt__ut2.settings.load_more.mode"
msgid "Paginator operation mode"
msgstr "Режим роботи пагінатора"

msgctxt "Languages::abt__ut2.settings.load_more.mode.variants.auto"
msgid "Automatically"
msgstr "Автоматично"

msgctxt "Languages::abt__ut2.settings.load_more.mode.variants.on_button_click"
msgid "By button click"
msgstr "При натисканні на кнопку"

msgctxt "Languages::abt__ut2.settings.load_more.mode.variants.semi_auto"
msgid "Semi-automatic"
msgstr "Напівавтоматично"

msgctxt "Languages::abt__ut2.settings.load_more.mode.tooltip"
msgid "Choose operating mode for \"Show more\" button .<br /> <b>Automatically</b> — in this mode next page will be loaded over N px before the end of page while scrolling down.<br /> <b>By button click</b> — next product page will be loaded only after clicking the button.<br /> <b>Semi-automatic</b> — uses a combination of modes \"By button click\" and \"Automatically\"."
msgstr "Оберіть режим роботи кнопки \"Показати ще\".<br />"
"<b>Автоматично</b> — в цьому режимі, наступна сторінка товарів буде завантажуватись за N px до кінця сторінки при прокрутці вниз.<br />"
"<b>При натисканні на кнопку</b> — завантаження наступної сторінки товарів буде відбуватись тільки при натисканні на кнопку.<br />"
"<b>Напівавтоматично</b> — використовує комбінацію режимів \"При натисканні на кнопку\" та \"Автоматично\"."

msgctxt "Languages::abt__ut2.settings.load_more.show_products_num"
msgid "Show number of loaded products"
msgstr "Показати кількість товарів, що підвантажуються"

msgctxt "Languages::abt__ut2.settings.load_more.show_products_num.tooltip"
msgid "Show the number of products that will be loaded in one iteration. Works only in the paginator mode \"By button click\" and for the first iteration of the mode \"Semi-automatic\"."
msgstr "Показувати кількість товарів, які будуть підвантажені за одну ітерацію. Працює тільки в режимі роботи пагінатора \"При натисканні на кнопку\" та для першої ітерації режиму \"Напівавтоматично\"."

msgctxt "Languages::abt__ut2.settings.load_more.before_end"
msgid "Start for N px to the end of the page"
msgstr "Запустити за N px до кінця сторінки"

msgctxt "Languages::abt__ut2.settings.load_more.before_end.tooltip"
msgid "Used only for working mode Automatically"
msgstr "Застосовується лише тоді, коли обрано варіант Автоматично"

msgctxt "Languages::abt__ut2.load_more.show_more.num.pages"
msgid "Show another [n] page|Show other [n] pages"
msgstr "Показати ще [n] сторінку|Показати ще [n] сторінки|Показати ще [n] сторінок"

msgctxt "Languages::abt__ut2.load_more.show_more.num.products"
