msgstr "Зазначте кількість для відображення товарів в ряд (тільки для \"Сітки\")"

msgctxt "Languages::abt__ut2.settings.products.addon_social_buttons_group"
msgid "Addon \"Social buttons\""
msgstr "Модуль \"Соціальні кнопки\""

msgctxt "Languages::abt__ut2.settings.products.addon_social_buttons_group_description"
msgid "Native CS-Cart addon \"Social Buttons\" displays Share buttons widgets for social networks"
msgstr "Нативний модуль CS-Cart \"Соціальні кнопки\" відображає віджети кнопок Поділитись для соціальних мереж"

msgctxt "Languages::abt__ut2.settings.products.addon_social_buttons.view"
