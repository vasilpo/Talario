msgstr "Варіант 1"

msgctxt "Languages::abt__ut2.less_settings.general.buttons.use_icon_cart.variants.type2"
msgid "Option 2"
msgstr "Варіант 2"

msgctxt "Languages::abt__ut2.less_settings.general.buttons.use_icon_cart.variants.type3"
msgid "Option 3"
