msgstr "Позволяет скруглить углы блоков, окон, баннеров. Радиус скругления зависит от значения настройки \"Скруглить углы для элементов интерфейса\"."

msgctxt "Languages::abt__ut2.less_settings.general.use_rounding_blocks.variants.do_not_use"
msgid "Don't use"
msgstr "Не использовать"

msgctxt "Languages::abt__ut2.less_settings.general.use_rounding_blocks.variants.little"
