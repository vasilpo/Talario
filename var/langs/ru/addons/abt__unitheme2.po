msgstr "Отображать текст заглавными буквами"

msgctxt "Languages::abt__ut2.less_settings.general.buttons.use_text_uppercase.tooltip"
msgid "Allows you to define the display format of letters in buttons, lowercase or uppercase letters"
msgstr "Позволяет определить формат отображения букв в кнопках, строчными или заглавными буквами"

msgctxt "Languages::abt__ut2.less_settings.general.buttons.use_shadow"
