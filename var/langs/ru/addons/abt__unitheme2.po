msgctxt "Languages::abt__ut2.less_settings.containers.header_elements_brightness"
msgid "Background brightness in the site header"
msgstr "Яркость фона в шапке сайта"

msgctxt "Languages::abt__ut2.less_settings.containers.header_elements_brightness.tooltip"
msgid "Determines the brightness of decorative elements in the site header when using a dark or light background"
msgstr "Позволяет правильно определить яркость декоративных элементов в шапке сайта при использовании темного или светлого фона"

msgctxt "Languages::abt__ut2.less_settings.containers.header_elements_brightness.variants.light"
msgid "Light"
msgstr "Светлый"

msgctxt "Languages::abt__ut2.less_settings.containers.header_elements_brightness.variants.dark"
msgid "Dark"
msgstr "Темный"

msgctxt "Languages::abt__ut2.less_settings.containers.top_panel_group"
msgid "Top panel"
msgstr "Верхняя панель"

msgctxt "Languages::abt__ut2.less_settings.containers.top_panel_group_description"
msgid "Settings for blocks and sections of the \"Top panel\" container"
msgstr "Настройки для блоков и секций контейнера \"Верхняя панель\""

msgctxt "Languages::abt__ut2.less_settings.containers.top_panel.height"
msgid "Height of the \"Top panel\" container (px)"
msgstr "Высота контейнера \"Верхняя панель\" (px)"

msgctxt "Languages::abt__ut2.less_settings.containers.header_group"
msgid "Header"
msgstr "Заголовок"

msgctxt "Languages::abt__ut2.less_settings.containers.header_group_description"
