msgctxt "Languages::abt__ut2.less_settings.general.style_tabs.variants.type4"
msgid "Option 4"
msgstr "Вариант 4"

msgctxt "Languages::abt__ut2.less_settings.general.use_titles_uppercase"
msgid "Display headers in capital letters"
msgstr "Отображать заголовки заглавными буквами"

msgctxt "Languages::abt__ut2.less_settings.general.use_titles_uppercase.tooltip"
msgid "Allows you to show headers in capital letters (used for all page headers, blocks, banners headers, etc.)"
msgstr "Позволяет перевести написание заголовка в заглавные буквы (применяется для всех заголовков страниц, блоков, баннеров и др.)"

