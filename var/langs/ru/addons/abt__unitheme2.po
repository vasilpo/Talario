msgid "Tabs style"
msgstr "Стиль оформления вкладок"

msgctxt "Languages::abt__ut2.less_settings.general.style_tabs.variants.type1"
msgid "Option 1"
msgstr "Вариант 1"

msgctxt "Languages::abt__ut2.less_settings.general.style_tabs.variants.type2"
msgid "Option 2"
msgstr "Вариант 2"

msgctxt "Languages::abt__ut2.less_settings.general.style_tabs.variants.type3"
