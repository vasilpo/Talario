msgctxt "Addons::name::lt_web_share_api"
msgid "Web Share API for product share button"
msgstr "Web Share API для кнопки поделиться у товара"

msgctxt "Addons::description::lt_web_share_api"
msgid "Adds Web Share API support to the Unitheme2 product share button with clipboard fallback."
msgstr "Добавляет поддержку Web Share API для кнопки поделиться в Unitheme2 с резервным копированием ссылки в буфер обмена."

msgctxt "Languages::lt_web_share_api.link_copied"
msgid "Link copied"
msgstr "Ссылка скопирована"

msgctxt "Languages::lt_web_share_api.copy_failed"
msgid "Failed to copy the link"
msgstr "Не удалось скопировать ссылку"
