msgctxt "Addons::name::exikane_changes"
msgid "Exikane changes"
msgstr "Exikane changes"

msgctxt "Addons::description::exikane_changes"
msgid "Custom changes for partner flows"
msgstr ""
"Модуль UI-доработок:\n"
"1. Гостевые и партнерские баннеры на витрине.\n"
"2. Улучшения UX авторизации, регистрации и показа пароля.\n"
"3. Theme-specific overrides для ABT Unitheme2.\n"
"4. Небольшие кастомизации интерфейса витрины и админки."


msgctxt "Languages::exikane_changes.partner_banner_title"
msgid "Get partner contacts and 200 bonuses from Talario"
msgstr "Получите контакты партнёра и 200 бонусов от Talario"

msgctxt "Languages::exikane_changes.partner_banner_text"
msgid "Bonuses can be used to pay for lessons from verified partners on the platform."
msgstr "Бонусами можно оплатить занятия у проверенных партнёров платформы."

msgctxt "Languages::exikane_changes.partner_banner_have_account"
msgid "Already have an account?"
msgstr "Уже есть аккаунт?"

