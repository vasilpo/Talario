msgctxt "Languages::sd_design_changes.request"
msgid "Request"
msgstr "Оставить заявку"

msgctxt "Languages::sd_design_changes.step"
msgid "Step"
msgstr "Шаг"

msgctxt "Languages::sd_design_changes.step_title_1"
msgid "Submit an application"
msgstr "Подайте заявку"

msgctxt "Languages::sd_design_changes.step_text_1"
msgid "Fill out the form on the website — specify the organization name and contacts. It will take 1 minute"
msgstr "Заполните форму на сайте — укажите название организации и контакты. Это займет 1 минуту"

msgctxt "Languages::sd_design_changes.step_title_2"
msgid "Discuss the terms"
msgstr "Обсудите условия"

msgctxt "Languages::sd_design_changes.step_text_2"
msgid "A manager will contact you within one business day to discuss the terms and commission size"
msgstr "Менеджер свяжется с вами в течение рабочего дня для обсуждения условий и размера комиссии"

msgctxt "Languages::sd_design_changes.step_title_3"
msgid "Start receiving applications"
msgstr "Начните получать заявки"

msgctxt "Languages::sd_design_changes.step_text_3"
msgid "After placing on the platform — receive applications from parents through your personal account"
msgstr "После размещения на платформе — получайте заявки от родителей через личный кабинет"

msgctxt "Languages::sd_design_changes.step_title_4"
msgid "Manage the process"
msgstr "Управляйте процессом"

msgctxt "Languages::sd_design_changes.step_text_4"
msgid "Use Talario tools for schedule and appointment management"
msgstr "Используйте инструменты Talario для управления расписанием и записями"

