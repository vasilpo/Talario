<?xml version="1.0"?>
<addon scheme="3.0">
    <id>exikane_changes</id>
    <version>1.0</version>
    <priority>4294967294</priority>
    <position>0</position>
    <auto_install>MULTIVENDOR,ULTIMATE</auto_install>
    <default_language>en</default_language>
    <supplier>Exikane</supplier>
    <settings edition_type="ROOT,STOREFRONT">
        <sections>
            <section id="general">
                <items>
                    <item id="partner_vendor_id">
                        <type>input</type>
                        <default_value>32</default_value>
                    </item>
                    <item id="welcome_bonus_enabled">
                        <type>checkbox</type>
                        <default_value>Y</default_value>
                    </item>
                    <item id="welcome_bonus_amount">
                        <type>input</type>
                        <default_value>200</default_value>
                    </item>
                    <item id="max_points_percent">
                        <type>input</type>
                        <default_value>50</default_value>
                    </item>
                </items>
            </section>
        </sections>
    </settings>
    <queries>
        <item>
            CREATE TABLE IF NOT EXISTS `?:exikane_partner_product_sites` (
                `product_id` int(11) unsigned NOT NULL,
                `site` varchar(255) NOT NULL DEFAULT '',
                PRIMARY KEY (`product_id`)
            ) Engine=MyISAM DEFAULT CHARSET UTF8;
        </item>
        <item>
            CREATE TABLE IF NOT EXISTS `?:exikane_partner_site_clicks` (
                `click_id` int(11) unsigned NOT NULL AUTO_INCREMENT,
                `user_id` int(11) unsigned NOT NULL DEFAULT '0',
                `email` varchar(255) NOT NULL DEFAULT '',
                `product_id` int(11) unsigned NOT NULL DEFAULT '0',
                `timestamp` int(11) unsigned NOT NULL DEFAULT '0',
                PRIMARY KEY (`click_id`),
                KEY `product_id` (`product_id`)
            ) Engine=MyISAM DEFAULT CHARSET UTF8;
        </item>
        <item for="uninstall">DROP TABLE IF EXISTS ?:exikane_partner_site_clicks;</item>
        <item for="uninstall">DROP TABLE IF EXISTS ?:exikane_partner_product_sites;</item>
    </queries>
</addon>
