<?xml version="1.0"?>
<addon scheme="4.0">
    <id>sd_design_changes</id>
    <version>4.15.1.1</version>
    <priority>11000</priority>
    <position>1</position>
    <status>active</status>
    <has_icon>Y</has_icon>
    <default_language>en</default_language>
    <supplier>Simtech Development</supplier>
    <supplier_link>https://www.simtechdev.com</supplier_link>
    <authors>
        <author>
            <name>Simtech Development</name>
            <email>sales@simtechdev.com</email>
            <url>https://www.simtechdev.com</url>
        </author>
    </authors>
    <compatibility>
        <core_version>
            <min>4.15.1</min>
        </core_version>
    </compatibility>
    <settings>
        <sections>
            <section id="vendors">
                <items>
                    <item id="metro_profile_field_id">
                        <type>selectbox</type>
                    </item>

                    <item id="apply_vendor_page_id">
                        <type>selectbox</type>
                    </item>
                </items>
            </section>
        </sections>
    </settings>
    <autoload>
        <psr4 prefix="Tygh\Addons\SdDesignChanges\">src</psr4>
    </autoload>
    <bootstrap>\Tygh\Addons\SdDesignChanges\Bootstrap</bootstrap>
    <queries>
        <item>ALTER TABLE ?:profile_fields ADD link TEXT NOT NULL DEFAULT ''</item>
        <item for="uninstall">ALTER TABLE ?:profile_fields DROP link</item>

        <item for="install">ALTER TABLE ?:product_descriptions ADD address varchar(255) NOT NULL DEFAULT '';</item>
        <item for="uninstall">ALTER TABLE ?:product_descriptions DROP address;</item>
    </queries>
</addon>
