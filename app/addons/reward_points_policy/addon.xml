<?xml version="1.0"?>
<addon scheme="4.0">
    <id>reward_points_policy</id>
    <version>1.0</version>
    <priority>31000</priority>
    <position>96</position>
    <status>active</status>
    <default_language>en</default_language>
    <auto_install>MULTIVENDOR,ULTIMATE</auto_install>
    <has_icon>Y</has_icon>
    <supplier>Larionov.tech</supplier>
    <supplier_link>https://larionov.tech</supplier_link>
